# Web on the root Vercel project: leave API_URL unset (same-origin /api).
# Local physical phone: use http://YOUR_COMPUTER_LAN_IP:5000/api.
# Android/iOS production: set https://YOUR_VERCEL_PROJECT.vercel.app/api.
EXPO_PUBLIC_API_URL=
# Only needed by legacy Socket.IO clients on a persistent backend:
EXPO_PUBLIC_SOCKET_URL=